{
  "name": "@wenaixi/dsh-ponytail",
  "version": "4.10.0-dsh.1",
  "description": "DSH 完整移植版 dietrichgebert/ponytail — 懒惰 senior 模式，6 个中文 Skill，无 tool 注册",
  "type": "module",
  "main": "lib/ponytail.js",
  "types": "lib/ponytail.d.ts",
  "files": [
    "lib/",
    "skills/",
    "assets/",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts 2>&1 || echo \"(no eslint config — skipped)\"",
    "verify": "node scripts/verify.mjs",
    "bump:dsh": "node scripts/bump-dsh.mjs",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": {
    "name": "Dietrich Gebert",
    "url": "https://github.com/DietrichGebert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenaixi/dsh-ponytail.git"
  },
  "homepage": "https://github.com/Wenaixi/dsh-ponytail#readme",
  "bugs": {
    "url": "https://github.com/Wenaixi/dsh-ponytail/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ponytail",
    "yagni",
    "skills",
    "agent-skills",
    "claude-code",
    "lazy",
    "over-engineering"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
