{
  "name": "@wenaixi/dsh-ponytail",
  "version": "5.4.0",
  "description": "DeepSeek Harness plugin: DietrichGebert/ponytail lazy senior mode & 7-rung ladder port, 6 skills with bilingual descriptions & per-skill toggles, zero tools, zero-cache-miss | DeepSeek Harness 插件：DietrichGebert/ponytail 懒人 senior 模式与七阶梯子完美移植，6 个技能描述双语自由切换，各个技能自由开关，零 tool 注册，全场景零缓存破坏",
  "type": "module",
  "main": "lib/ponytail.js",
  "types": "lib/ponytail.d.ts",
  "files": [
    "lib/",
    "skills/",
    "assets/logo.png",
    "assets/icon.png",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts 2>&1 || echo \"(no eslint config — skipped)\"",
    "verify": "node scripts/verify.mjs",
    "docs:verify": "node scripts/docs-verify.mjs",
    "version:set": "node scripts/version.mjs",
    "version:bump": "node scripts/version.mjs",
    "prepublishOnly": "npm run build && npm run verify && npm test",
    "test": "node scripts/behavior.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": {
    "name": "Dietrich Gebert",
    "url": "https://github.com/DietrichGebert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenaixi/dsh-ponytail.git"
  },
  "homepage": "https://github.com/Wenaixi/dsh-ponytail#readme",
  "icon": "assets/icon.png",
  "bugs": {
    "url": "https://github.com/Wenaixi/dsh-ponytail/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "ponytail",
    "yagni",
    "skills",
    "agent-skills",
    "lazy",
    "over-engineering",
    "code-review",
    "prompt-caching",
    "kv-cache",
    "prompt-engineering",
    "ai-agents",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/ponytail.d.ts",
      "default": "./lib/ponytail.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  }
}
