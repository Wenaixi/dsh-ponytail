{
  "name": "dsh-ponytail",
  "version": "4.9.0",
  "description": "DSH 完整移植版 dietrichgebert/ponytail — 懒惰 senior 模式，6 个中文 Skill，无空 tool",
  "type": "module",
  "main": "lib/ponytail.js",
  "types": "lib/ponytail.d.ts",
  "files": [
    "lib/",
    "skills/",
    "assets/",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts 2>&1 || echo \"(no eslint config — skipped)\"",
    "prepare": "npm run build",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Dietrich Gebert",
    "url": "https://github.com/DietrichGebert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenaixi/dsh-ponytail.git"
  },
  "homepage": "https://github.com/Wenaixi/dsh-ponytail#readme",
  "bugs": {
    "url": "https://github.com/Wenaixi/dsh-ponytail/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ponytail",
    "yagni",
    "skills",
    "agent-skills",
    "claude-code",
    "lazy",
    "over-engineering"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
