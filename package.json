{
  "name": "@wenaixi/dsh-ponytail",
  "version": "4.10.0-dsh.4",
  "description": "DietrichGebert/ponytail 的 DSH 完整移植：常驻懒人 senior 模式与七阶梯子（YAGNI 到最小实现），6 个中文原生技能（本体、评审、审计、债务、收益、帮助），零 tool 注册",
  "type": "module",
  "main": "lib/ponytail.js",
  "types": "lib/ponytail.d.ts",
  "files": [
    "lib/",
    "skills/",
    "assets/logo.png",
    "assets/icon.png",
    "locale/",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts 2>&1 || echo \"(no eslint config — skipped)\"",
    "verify": "node scripts/verify.mjs",
    "bump:dsh": "node scripts/bump-dsh.mjs",
    "prepublishOnly": "npm run build && npm run verify && npm test",
    "test": "node scripts/behavior.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": {
    "name": "Dietrich Gebert",
    "url": "https://github.com/DietrichGebert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenaixi/dsh-ponytail.git"
  },
  "homepage": "https://github.com/Wenaixi/dsh-ponytail#readme",
  "icon": "assets/icon.png",
  "bugs": {
    "url": "https://github.com/Wenaixi/dsh-ponytail/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ponytail",
    "yagni",
    "skills",
    "agent-skills",
    "lazy",
    "over-engineering"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/ponytail.d.ts",
      "default": "./lib/ponytail.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  }
}
